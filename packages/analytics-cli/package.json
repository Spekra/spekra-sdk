{
  "name": "@spekra/analytics-cli",
  "version": "0.1.0-alpha.2",
  "description": "CLI utilities for uploading JUnit reports to Spekra",
  "bin": {
    "spekra-analytics": "./dist/cli.mjs"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^13.1.0",
    "picomatch": "^4.0.4"
  },
  "devDependencies": {
    "@spekra/core": "workspace:*",
    "@types/node": "^20.10.0",
    "@types/picomatch": "^4.0.3",
    "@vitest/coverage-v8": "^1.0.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.0.1",
    "tsdown": "^0.21.9",
    "tslib": "^2.8.1",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.59.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist node_modules",
    "dev": "tsdown --watch",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "types": "./dist/index.d.cts"
}
